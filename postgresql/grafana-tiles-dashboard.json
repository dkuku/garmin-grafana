          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "targets": [
          {
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "WITH all_tiles AS ( SELECT floor((longitude + 180.0) / 360.0 * power(2, $zoom))::int AS tx, floor((1.0 - ln(tan(radians(latitude)) + 1.0/cos(radians(latitude))) / pi()) / 2.0 * power(2, $zoom))::int AS ty, min(ts) AS first_visit FROM activity_gps WHERE latitude IS NOT NULL AND longitude IS NOT NULL AND latitude BETWEEN -85 AND 85 GROUP BY 1, 2 ) SELECT count(*) AS \"New Tiles\" FROM all_tiles WHERE first_visit >= now() - interval '30 days'",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Cumulative Tiles Over Time",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "green" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 20,
              "pointSize": 1,
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "single", "sort": "none" },
          "legend": { "displayMode": "hidden" }
        },
        "targets": [
          {
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "WITH tile_first AS ( SELECT floor((longitude + 180.0) / 360.0 * power(2, $zoom))::int AS tx, floor((1.0 - ln(tan(radians(latitude)) + 1.0/cos(radians(latitude))) / pi()) / 2.0 * power(2, $zoom))::int AS ty, min(ts) AS first_visit FROM activity_gps WHERE latitude IS NOT NULL AND longitude IS NOT NULL AND latitude BETWEEN -85 AND 85 GROUP BY 1, 2 ), daily_new AS ( SELECT first_visit::date AS day, count(*) AS new_tiles FROM tile_first GROUP BY 1 ) SELECT day::timestamptz AS time, sum(new_tiles) OVER (ORDER BY day) AS \"Total Tiles\" FROM daily_new ORDER BY day",
            "format": "time_series",
            "refId": "A"
          }
        ]
      },
