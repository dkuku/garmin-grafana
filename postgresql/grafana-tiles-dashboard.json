          "graphMode": "none",
          "justifyMode": "auto"
        },
        "targets": [
          {
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "WITH tiles AS ( SELECT DISTINCT floor((longitude + 180.0) / 360.0 * power(2, $zoom))::int AS tx, floor((1.0 - ln(tan(radians(latitude)) + 1.0/cos(radians(latitude))) / pi()) / 2.0 * power(2, $zoom))::int AS ty FROM activity_gps WHERE latitude IS NOT NULL AND longitude IS NOT NULL AND latitude BETWEEN -85 AND 85 ) SELECT count(*) AS \"Tiles\" FROM tiles",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Activities with GPS",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "blue" }
