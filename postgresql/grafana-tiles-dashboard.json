        "targets": [
          {
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "WITH tile_activity AS ( SELECT DISTINCT floor((g.longitude + 180.0) / 360.0 * power(2, $zoom))::int AS tx, floor((1.0 - ln(tan(radians(g.latitude)) + 1.0/cos(radians(g.latitude))) / pi()) / 2.0 * power(2, $zoom))::int AS ty, a.activity_type FROM activity_gps g JOIN activity_summary a ON g.activity_id = a.activity_id WHERE g.latitude IS NOT NULL AND g.longitude IS NOT NULL AND g.latitude BETWEEN -85 AND 85 ) SELECT COALESCE(activity_type, 'Unknown') AS \"Activity Type\", count(*) AS \"Tiles\" FROM tile_activity GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
