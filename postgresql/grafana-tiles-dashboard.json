          "tooltip": {
            "mode": "details"
          }
        },
        "targets": [
          {
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "WITH tiles AS ( SELECT floor((longitude + 180.0) / 360.0 * power(2, $zoom))::int AS tx, floor((1.0 - ln(tan(radians(latitude)) + 1.0/cos(radians(latitude))) / pi()) / 2.0 * power(2, $zoom))::int AS ty, count(*) AS visits FROM activity_gps WHERE latitude IS NOT NULL AND longitude IS NOT NULL AND latitude BETWEEN -85 AND 85 GROUP BY 1, 2 ) SELECT (tx + 0.5) / power(2, $zoom) * 360.0 - 180.0 AS lon, degrees(atan(sinh(pi() * (1.0 - 2.0 * (ty + 0.5) / power(2, $zoom))))) AS lat, visits FROM tiles ORDER BY visits DESC",
            "format": "table",
            "refId": "A"
