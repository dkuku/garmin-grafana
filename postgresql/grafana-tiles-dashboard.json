            "datasource": { "type": "grafana-postgresql-datasource", "uid": "P2C399511F46274E2" },
            "rawSql": "SELECT count(DISTINCT activity_id) AS \"Activities\" FROM activity_gps WHERE latitude IS NOT NULL",
            "format": "table",
            "refId": "A"
