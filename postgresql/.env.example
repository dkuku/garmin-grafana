# Garmin Connect credentials
GARMIN_EMAIL=your@email.com
# Either plain password or base64-encoded (choose one)
GARMIN_PASSWORD=your_password
# GARMIN_PASSWORD_B64=base64_encoded_password

# Token persistence (default: ~/.garminconnect)
# GARMIN_TOKEN_DIR=/opt/garmin-postgres/.garminconnect

# PostgreSQL connection
PG_HOST=192.168.30.104
PG_PORT=5432
PG_DATABASE=garmin
PG_USER=garmin
PG_PASSWORD=your_pg_password

# Sync interval in seconds (default: 300 = 5 min)
# UPDATE_INTERVAL=300

# Timezone for date calculations
# USER_TIMEZONE=Europe/Warsaw

# Manual bulk import — set both dates, fetcher will import range and exit
# MANUAL_START_DATE=2024-01-01
# MANUAL_END_DATE=2024-12-31

# Comma-separated data types to fetch (empty = all)
# Available: daily_stats,heart_rate,steps,stress,body_battery,sleep,breathing_rate,
#            hrv,body_composition,activities,vo2_max,race_predictions,fitness_age,
#            training_status,training_readiness,hill_score,endurance_score,
#            blood_pressure,hydration
# FETCH_SELECTION=
